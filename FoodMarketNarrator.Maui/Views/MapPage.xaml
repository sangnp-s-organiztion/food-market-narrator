<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             xmlns:shared="clr-namespace:food_market_narrator.Views.Shared"
             x:Class="food_market_narrator.Views.MapPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="*, Auto" RowSpacing="0">
        <!-- Main Map Content -->
        <Grid Grid.Row="0">
            <mapsui:MapControl x:Name="mapControl" Grid.Row="1" />

            <!-- Top Overlay: Search & Filters -->
            <VerticalStackLayout Spacing="10" Margin="20,20,20,0" VerticalOptions="Start">
                <!-- Search Bar Row -->
                <Border Grid.Column="1" Margin="0,0,50,0" StrokeShape="RoundRectangle 20" HeightRequest="40" WidthRequest="250" BackgroundColor="White" StrokeThickness="0" Padding="15,0">
                    <Border.Shadow>
                        <Shadow Brush="#000" Opacity="0.1" Radius="5"/>
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Label Grid.Column="0"
                           Text="&#xf002;"
                           FontFamily="FASolid"
                           VerticalOptions="Center"
                           TextColor="#9AA0A6"
                           Margin="0,0,10,0"
                           FontSize="16"/>

                                    <Entry x:Name="SearchEntry"
                           Grid.Column="1"
                           Placeholder="Tìm món ăn hoặc quán..."
                           VerticalOptions="Center"
                           BackgroundColor="Transparent"
                           ClearButtonVisibility="WhileEditing"
                           ReturnType="Search"
                           Completed="OnSearchSubmitted"
                           TextChanged="OnSearchTextChanged"
                           FontSize="14"
                           TextColor="#3C4043"
                           PlaceholderColor="#9AA0A6"/> 

                        <Label x:Name="SearchClearButton"
                           Grid.Column="2"
                           IsVisible="False"
                           Text="&#xf00d;"
                           FontFamily="FASolid"
                           VerticalOptions="Center"
                           HorizontalOptions="End"
                           TextColor="#9AA0A6"
                           FontSize="14">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnClearSearchTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>

                <Border x:Name="SearchSuggestionsContainer"
                        IsVisible="False"
                        Margin="0,-4,50,0"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="6,4">
                    <Border.Shadow>
                        <Shadow Brush="#000" Opacity="0.12" Radius="8"/>
                    </Border.Shadow>

                    <CollectionView x:Name="SearchSuggestionsView"
                                    SelectionMode="Single"
                                    SelectionChanged="OnSearchSuggestionSelected"
                                    HeightRequest="200">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="2" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10,8" RowDefinitions="Auto,Auto" ColumnDefinitions="*">
                                    <Label Grid.Row="0"
                                           Text="{Binding Name}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#202124"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Grid.Row="1"
                                           Text="{Binding AddressDisplay}"
                                           FontSize="12"
                                           TextColor="#5F6368"
                                           LineBreakMode="TailTruncation"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

                <Border x:Name="TourFilterBanner"
                        IsVisible="False"
                        Margin="0,-2,50,0"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="#FFF7ED"
                        Stroke="#FED7AA"
                        StrokeThickness="1"
                        Padding="10,8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="0">
                            <Label x:Name="TourFilterTitle"
                                Text="Đang xem theo hành trình"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#9A3412" />
                            <Label Text="Chỉ hiển thị các POI thuộc hành trình đã chọn"
                                   FontSize="11"
                                   TextColor="#C2410C" />
                        </VerticalStackLayout>
                        <Button Text="Hiện tất cả"
                            Grid.Column="1"
                                Clicked="OnClearTourFilterClicked"
                            BackgroundColor="White"
                            TextColor="#C2410C"
                            FontSize="10"
                            Padding="10,0"
                            BorderColor="#FED7AA"
                            BorderWidth="1"
                            CornerRadius="14"
                            HeightRequest="28"
                            HorizontalOptions="End"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Filters -->
                <ScrollView x:Name="CategoryFiltersScrollView" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="10" HeightRequest="40" Padding="0,5">
                        <!-- All -->
                        <Border x:Name="MapFilterAllChip" BackgroundColor="#F48C06" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="15,0" HeightRequest="32">
                             <Border.GestureRecognizers>
                                 <TapGestureRecognizer Tapped="OnMapFilterAllTapped"/>
                             </Border.GestureRecognizers>
                             <Border.Shadow>
                                 <Shadow Brush="#000" Opacity="0.1" Radius="2"/>
                            </Border.Shadow>
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label x:Name="MapFilterAllIcon" Text="&#xf00c;" FontFamily="FASolid" TextColor="White" VerticalOptions="Center" FontSize="12"/>
                                <Label x:Name="MapFilterAllLabel" Text="Tất cả" TextColor="White" VerticalOptions="Center" FontSize="13" FontAttributes="Bold"/>
                            </HorizontalStackLayout>
                        </Border>
                         <!-- Near You -->
                        <Border x:Name="MapFilterNearChip" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="15,0" HeightRequest="32">
                             <Border.GestureRecognizers>
                                 <TapGestureRecognizer Tapped="OnMapFilterNearTapped"/>
                             </Border.GestureRecognizers>
                             <Border.Shadow>
                                 <Shadow Brush="#000" Opacity="0.1" Radius="2"/>
                            </Border.Shadow>
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label x:Name="MapFilterNearIcon" Text="&#xf3c5;" FontFamily="FASolid" TextColor="#3C4043" VerticalOptions="Center" FontSize="12"/>
                                <Label x:Name="MapFilterNearLabel" Text="Gần bạn" TextColor="#3C4043" VerticalOptions="Center" FontSize="13" FontAttributes="Bold"/>
                            </HorizontalStackLayout>
                        </Border>

                         <!-- Favorites -->
                        <Border x:Name="MapFilterFavoriteChip" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="15,0" HeightRequest="32">
                             <Border.GestureRecognizers>
                                 <TapGestureRecognizer Tapped="OnMapFilterFavoriteTapped"/>
                             </Border.GestureRecognizers>
                             <Border.Shadow>
                                 <Shadow Brush="#000" Opacity="0.1" Radius="2"/>
                            </Border.Shadow>
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label x:Name="MapFilterFavoriteIcon" Text="&#xf004;" FontFamily="FASolid" TextColor="#3C4043" VerticalOptions="Center" FontSize="12"/>
                                <Label x:Name="MapFilterFavoriteLabel" Text="Yêu thích" TextColor="#3C4043" VerticalOptions="Center" FontSize="13" FontAttributes="Bold"/>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Open Now -->
                        <Border x:Name="MapFilterOpenChip" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="15,0" HeightRequest="32">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMapFilterOpenTapped"/>
                            </Border.GestureRecognizers>
                            <Border.Shadow>
                                 <Shadow Brush="#000" Opacity="0.1" Radius="2"/>
                            </Border.Shadow>
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label x:Name="MapFilterOpenIcon" Text="&#xf017;" FontFamily="FASolid" TextColor="#3C4043" VerticalOptions="Center" FontSize="12"/>
                                <Label x:Name="MapFilterOpenLabel" Text="Đang mở" TextColor="#3C4043" VerticalOptions="Center" FontSize="13" FontAttributes="Bold"/>
                            </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>

            <!-- Right Controls -->
            <VerticalStackLayout Grid.Row="0" HorizontalOptions="End" VerticalOptions="Center" Spacing="15" Margin="15">
                <Border HeightRequest="45" WidthRequest="45" StrokeShape="RoundRectangle 22.5" BackgroundColor="White" StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="#000" Opacity="0.15" Radius="5"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnZoomInTapped"/>
                    </Border.GestureRecognizers>
                    <Label Text="&#x2b;" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#3C4043" FontSize="22" FontAttributes="Bold"/>
                </Border>

                <Border HeightRequest="45" WidthRequest="45" StrokeShape="RoundRectangle 22.5" BackgroundColor="White" StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="#000" Opacity="0.15" Radius="5"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnZoomOutTapped"/>
                    </Border.GestureRecognizers>
                    <Label Text="&#x2212;" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#3C4043" FontSize="26" FontAttributes="Bold"/>
                </Border>

                <Border HeightRequest="45" WidthRequest="45" StrokeShape="RoundRectangle 22.5" BackgroundColor="White" StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="#000" Opacity="0.15" Radius="5"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMyLocationTapped"/>
                    </Border.GestureRecognizers>
                    <Label Text="&#xf3c5;" FontFamily="FASolid" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#3C4043" FontSize="18"/>
                </Border>
            </VerticalStackLayout>

            <!-- Bottom Detail Card -->
            <Border x:Name="SelectedPoiCard" IsVisible="False" VerticalOptions="End" Margin="20,0,20,30" BackgroundColor="White" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="15">
                <Border.Shadow>
                    <Shadow Brush="#000" Opacity="0.2" Radius="10" Offset="0,4"/>
                </Border.Shadow>
                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="90, *" RowSpacing="10" ColumnSpacing="15">
                    <!-- Image -->
                    <Border Grid.RowSpan="2" HeightRequest="90" WidthRequest="90" StrokeShape="RoundRectangle 15" StrokeThickness="0" BackgroundColor="#EEE">
                        <Image x:Name="SelectedPoiImage" Source="dotnet_bot.svg" Aspect="AspectFill"/>
                    </Border>

                    <!-- Info -->
                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label x:Name="SelectedPoiName" Text="Điểm đến" FontAttributes="Bold" FontSize="16" TextColor="Black" VerticalOptions="Center"/>
                             <!-- Nút thuyết minh âm thanh -->
                            <!--<Border BackgroundColor="#F48C06" StrokeThickness="0" StrokeShape="RoundRectangle 15" Padding="12,6" HorizontalOptions="End">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="&#xf025;" FontFamily="FASolid" TextColor="White" FontSize="12" VerticalOptions="Center"/>
                                    <Label Text="Thuyết minh âm thanh" TextColor="White" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>-->
                        </Grid>

                        <HorizontalStackLayout Spacing="10" Margin="0,5,0,0">
                             <HorizontalStackLayout Spacing="4">
                                  <Label Text="&#xf124;" FontFamily="FASolid" TextColor="#5F6368" FontSize="12" VerticalOptions="Center"/>
                                  <Label x:Name="SelectedPoiAddress" Text="Đang cập nhật địa chỉ" TextColor="#5F6368" FontSize="12" VerticalOptions="Center" />
                             </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Buttons -->
                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*" ColumnSpacing="10" VerticalOptions="End">
                        <Button x:Name="ViewDetailButton" Clicked="OnViewDetailClicked" Text="Xem chi tiết" BackgroundColor="#F48C06" TextColor="White" FontSize="12" CornerRadius="18" HeightRequest="36" Padding="0" FontAttributes="Bold"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Navigation Bar -->
        <shared:BottomNavigationView
            ActiveTab="Map"
            Grid.Row="1"
            />

    </Grid>
</ContentPage>
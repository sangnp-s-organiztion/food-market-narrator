<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:food_market_narrator.Models"
             x:Class="food_market_narrator.Views.TourDetailPage"
             x:DataType="models:TourModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#ECEDEF">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">
        <Grid Grid.Row="0" BackgroundColor="White" Padding="16,12,16,10" ColumnDefinitions="40,*,40">
            <Border Grid.Column="0"
                    StrokeThickness="0"
                    BackgroundColor="#FFF2E5"
                    HeightRequest="34"
                    WidthRequest="34"
                    StrokeShape="RoundRectangle 17"
                    VerticalOptions="Center"
                    HorizontalOptions="Start">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackButtonTapped"/>
                </Border.GestureRecognizers>
                <Label Text="&#xf060;"
                       FontFamily="FASolid"
                       FontSize="14"
                       TextColor="#F57C00"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

                        <Label Grid.Column="1"
                                     Text="Chi tiết hành trình"
                   FontSize="19"
                   FontFamily="OpenSansSemibold"
                   TextColor="#242424"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout x:Name="ContentContainer" Spacing="16" IsVisible="False" Padding="0,0,0,20">
                    <Grid RowDefinitions="230,Auto" RowSpacing="0">
                        <Border Grid.Row="0"
                                Margin="0"
                                StrokeThickness="0"
                                HeightRequest="230"
                                BackgroundColor="#D5D5D5">
                            <Grid>
                                <Image Source="{Binding DisplayImageSource}"
                                       Aspect="AspectFill"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Margin="28,-38,28,0"
                                BackgroundColor="#F8F6F4"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 28"
                                Padding="14,10">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="0">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="&#xf017;"
                                           FontFamily="FASolid"
                                           FontSize="15"
                                           TextColor="#F39C12"
                                           HorizontalOptions="Center"/>
                                    <Label x:Name="DurationMetricValue"
                                           Text="--"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="20"
                                           TextColor="#222222"
                                           HorizontalOptions="Center"/>
                                    <Label Text="THỜI GIAN"
                                           FontSize="11"
                                           TextColor="#909090"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>

                                <BoxView Grid.Column="1" WidthRequest="1" Color="#E7E1DA" HorizontalOptions="Start" VerticalOptions="Fill"/>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="&#xf0f5;"
                                           FontFamily="FASolid"
                                           FontSize="15"
                                           TextColor="#F39C12"
                                           HorizontalOptions="Center"/>
                                    <Label x:Name="StopMetricValue"
                                           Text="0"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="20"
                                           TextColor="#222222"
                                           HorizontalOptions="Center"/>
                                    <Label Text="ĐỊA ĐIỂM"
                                           FontSize="11"
                                           TextColor="#909090"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>

                    <VerticalStackLayout Padding="20,0" Spacing="0">
                        <Label Text="{Binding Name}"
                               FontFamily="OpenSansSemibold"
                               FontSize="20"
                               TextColor="#262626"
                               LineBreakMode="TailTruncation"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Padding="20,0" Spacing="7">
                        <Label Text="HÀNH TRÌNH KHÁM PHÁ"
                               FontFamily="OpenSansSemibold"
                               FontSize="17"
                               TextColor="#B37846"
                               CharacterSpacing="1.1"/>

                        <Label x:Name="TourDescriptionLabel"
                               FontSize="16"
                               TextColor="#2F2F2F"
                               LineBreakMode="WordWrap"
                               LineHeight="1.4"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Padding="20,0" Spacing="8">
                        <Grid ColumnDefinitions="*" VerticalOptions="Center">
                            <Label Text="LỊCH TRÌNH CHI TIẾT"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="17"
                                   TextColor="#B37846"
                                   CharacterSpacing="1.1"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <CollectionView x:Name="StopsCollectionView"
                                        ItemsSource="{Binding Stops}"
                                        SelectionMode="Single"
                                        SelectionChanged="OnStopSelectionChanged"
                                        Margin="0,2,0,0">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                            </CollectionView.ItemsLayout>

                            <CollectionView.EmptyView>
                                <Label Text="Hành trình này chưa có điểm dừng."
                                       FontSize="14"
                                       TextColor="#929292"
                                       HorizontalOptions="Center"
                                       Margin="0,14,0,0"/>
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:TourStopModel">
                                    <Grid ColumnDefinitions="34,*" ColumnSpacing="8" Padding="0,0,0,0">
                                        <Grid>
                                            <BoxView Color="#F0D8BD"
                                                     WidthRequest="1.5"
                                                     VerticalOptions="Fill"
                                                     HorizontalOptions="Center"
                                                     Margin="0,24,0,0"/>

                                            <Border HeightRequest="26"
                                                    WidthRequest="26"
                                                    StrokeThickness="0"
                                                    BackgroundColor="#F39C12"
                                                    StrokeShape="RoundRectangle 13"
                                                    VerticalOptions="Start"
                                                    HorizontalOptions="Center">
                                                <Label Text="{Binding StopOrder}"
                                                       TextColor="White"
                                                       FontSize="12"
                                                       FontFamily="OpenSansSemibold"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Border>
                                        </Grid>

                                        <Border Grid.Column="1"
                                                StrokeThickness="0"
                                                BackgroundColor="#F5F0EA"
                                                StrokeShape="RoundRectangle 22"
                                                Padding="14,11">
                                            <Grid ColumnDefinitions="*,64" ColumnSpacing="8">
                                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                    <Label Text="{Binding RestaurantName}"
                                                           FontSize="17"
                                                           FontFamily="OpenSansSemibold"
                                                           TextColor="#242424"
                                                           LineBreakMode="TailTruncation"/>

                                                    <Label Text="{Binding Address}"
                                                           FontSize="13"
                                                           TextColor="#A0764D"
                                                           LineBreakMode="TailTruncation"/>
                                                </VerticalStackLayout>

                                                <Border Grid.Column="1"
                                                        HeightRequest="54"
                                                        WidthRequest="54"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 27"
                                                        BackgroundColor="#E0E0E0"
                                                        HorizontalOptions="End"
                                                        VerticalOptions="Center">
                                                    <Image Source="{Binding PrimaryImageUrl}" Aspect="AspectFill"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout x:Name="LoadingContainer"
                                 IsVisible="True"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="10">
                <ActivityIndicator IsRunning="True" Color="#F39C12" WidthRequest="30" HeightRequest="30"/>
                <Label Text="Đang tải chi tiết hành trình..." FontSize="14" TextColor="#777777"/>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="ErrorContainer"
                                 IsVisible="False"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="10"
                                 Padding="24">
                                <Label Text="Không thể tải chi tiết hành trình."
                       FontSize="16"
                       FontFamily="OpenSansSemibold"
                       TextColor="#3A3A3A"
                       HorizontalTextAlignment="Center"/>
                <Label Text="Vui lòng thử lại sau."
                       FontSize="14"
                       TextColor="#8A8A8A"
                       HorizontalTextAlignment="Center"/>
                <Button Text="Thử lại"
                        Clicked="OnRetryClicked"
                        HeightRequest="44"
                        CornerRadius="22"
                        Padding="22,0"
                        BackgroundColor="#F39C12"
                        TextColor="White"
                        FontFamily="OpenSansSemibold"/>
            </VerticalStackLayout>
        </Grid>

        <Border x:Name="BottomActionContainer"
                Grid.Row="2"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="16,10,16,14"
                StrokeShape="RoundRectangle 24,24,0,0">
            <Button x:Name="StartJourneyButton"
                    Text="Bắt đầu hành trình"
                    FontFamily="OpenSansSemibold"
                    FontSize="18"
                    HeightRequest="56"
                    CornerRadius="28"
                    BackgroundColor="#F39C12"
                    TextColor="White"
                    Clicked="OnStartJourneyClicked"/>
        </Border>
    </Grid>
</ContentPage>

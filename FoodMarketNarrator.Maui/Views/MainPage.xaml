<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:food_market_narrator.Views.Shared"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             x:Class="food_market_narrator.Views.MainPage"
             BackgroundColor="#FFFCF8"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto" RowSpacing="0">
        <Grid Grid.Row="0">
            <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="15" Padding="20,10,20,120">

                <!-- 1. Header -->
                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                    <!-- Icon placeholder -->
                    <Border Stroke="#FFF3E0" StrokeThickness="0" BackgroundColor="#FFF3E0" 
                            HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20">
                        <Label Text="&#xf2e7;" FontFamily="FASolid" TextColor="#F48C06" 
                               HorizontalOptions="Center" VerticalOptions="Center" FontSize="18"/>
                    </Border>

                    <!-- Title -->
                    <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center" Spacing="0">
                        <Label Text="Ẩm thực Vĩnh Khánh" FontSize="18" FontAttributes="Bold" TextColor="#1A1A1A"/>
                        <Label Text="Khám phá thiên đường ẩm thực" FontSize="12" TextColor="#9E9E9E"/>
                    </VerticalStackLayout>

                    <!-- User Icon (chưa đăng nhập) -->
                    <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="#F0F0F0"
                            HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnUserIconTapped"/>
                        </Border.GestureRecognizers>
                            <Label Text="&#xf007;" FontFamily="FASolid" TextColor="#1A1A1A"
                               HorizontalOptions="Center" VerticalOptions="Center" FontSize="18"/>
                    </Border>
                </Grid>

                <!-- 2. Search Bar -->
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <Border StrokeThickness="0" BackgroundColor="#F5F1EE" StrokeShape="RoundRectangle 25" HeightRequest="50" Padding="15,0">
                        <Grid ColumnDefinitions="Auto, *">
                            <Label Text="&#xf002;" FontFamily="FASolid" TextColor="#8D6E63" 
                                   VerticalOptions="Center" FontSize="16" Margin="0,0,10,0"/>
                            <Entry Grid.Column="1" Placeholder="Tìm ốc, phá lấu, đồ nướng..." 
                                   FontSize="14" VerticalOptions="Center" BackgroundColor="Transparent" TextColor="#3E2723" PlaceholderColor="#8D6E63"/>
                        </Grid>
                    </Border>

                    <!-- Filter Button -->
                    <Button Grid.Column="1" Text="" BackgroundColor="#F48C06" HeightRequest="50" WidthRequest="50" CornerRadius="25">
                         <Button.ImageSource>
                            <FontImageSource Glyph="&#xf1de;" FontFamily="FASolid" Color="White" Size="20"/>
                        </Button.ImageSource>
                    </Button>
                </Grid>

                <!-- 3. Map Section -->
                <Grid Margin="-20,0" Padding="0,0,0,2">
                    <Border HeightRequest="250" StrokeShape="RoundRectangle 24" StrokeThickness="0" BackgroundColor="White" Margin="12,0">
                        <Grid>
                            <mapsui:MapControl x:Name="mapControl" />

                            <VerticalStackLayout HorizontalOptions="End" VerticalOptions="Center" Spacing="10" Margin="0,0,14,0">
                                <Border HeightRequest="38" WidthRequest="38" StrokeShape="RoundRectangle 19" BackgroundColor="White" StrokeThickness="0">
                                    <Border.Shadow>
                                        <Shadow Brush="#000" Opacity="0.14" Radius="5"/>
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnZoomInTapped"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="&#x2b;" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#3C4043" FontSize="18" FontAttributes="Bold"/>
                                </Border>

                                <Border HeightRequest="38" WidthRequest="38" StrokeShape="RoundRectangle 19" BackgroundColor="White" StrokeThickness="0">
                                    <Border.Shadow>
                                        <Shadow Brush="#000" Opacity="0.14" Radius="5"/>
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnZoomOutTapped"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="&#x2212;" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#3C4043" FontSize="22" FontAttributes="Bold"/>
                                </Border>

                                <Border HeightRequest="38" WidthRequest="38" StrokeShape="RoundRectangle 19" BackgroundColor="White" StrokeThickness="0">
                                    <Border.Shadow>
                                        <Shadow Brush="#000" Opacity="0.14" Radius="5"/>
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMyLocationTapped"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="&#xf3c5;" FontFamily="FASolid" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#3C4043" FontSize="15"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 4. Categories -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="10" HeightRequest="40">
                        <!-- 'All' Button -->
                        <Border x:Name="MainFilterAllChip" BackgroundColor="#F48C06" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="15,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFilterAllTapped"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="MainFilterAllLabel" Text="Tất cả" TextColor="White" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                        </Border>

                        <!-- Other Categories -->
                        <Border x:Name="MainFilterNearChip" BackgroundColor="#F5F1EE" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="15,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFilterNearTapped"/>
                            </Border.GestureRecognizers>
                             <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                 <Label x:Name="MainFilterNearIcon" Text="&#xf3c5;" FontFamily="FASolid" TextColor="#3E2723" FontSize="12"/>
                                 <Label x:Name="MainFilterNearLabel" Text="Gần bạn" TextColor="#3E2723" FontSize="13" FontAttributes="Bold"/>
                             </HorizontalStackLayout>
                        </Border>

                         <Border x:Name="MainFilterFavoriteChip" BackgroundColor="#F5F1EE" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="15,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFilterFavoriteTapped"/>
                            </Border.GestureRecognizers>
                             <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                 <Label x:Name="MainFilterFavoriteIcon" Text="&#xf004;" FontFamily="FASolid" TextColor="#3E2723" FontSize="12"/>
                                 <Label x:Name="MainFilterFavoriteLabel" Text="Yêu thích" TextColor="#3E2723" FontSize="13" FontAttributes="Bold"/>
                             </HorizontalStackLayout>
                        </Border>

                         <Border x:Name="MainFilterOpenChip" BackgroundColor="#F5F1EE" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="15,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFilterOpenTapped"/>
                            </Border.GestureRecognizers>
                             <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                 <Label x:Name="MainFilterOpenIcon" Text="&#xf017;" FontFamily="FASolid" TextColor="#3E2723" FontSize="12"/>
                                 <Label x:Name="MainFilterOpenLabel" Text="Đang mở" TextColor="#3E2723" FontSize="13" FontAttributes="Bold"/>
                             </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- 5. Featured Section Header -->
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Quán ngon nổi bật" FontSize="16" FontAttributes="Bold" TextColor="#1A1A1A"/>
                    <Label Grid.Column="1" Text="Xem tất cả" FontSize="13" TextColor="#F48C06"/>
                </Grid>

                <!-- 6. List Items -->
                <CollectionView x:Name="PoiList" 
                    SelectionMode="Single"
                    SelectionChanged="OnPoiDetailTapped"
                    >
                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border BackgroundColor="White"
                                    StrokeShape="RoundRectangle 20"
                                    StrokeThickness="0"
                                    Padding="10"
                                    Margin="0,5">

                            <!-- khi nhấm vào POI -->
                            <!-- <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPoiDetailTapped"/>
                            </Border.GestureRecognizers> -->
                            

                                <Border.Shadow>
                                    <Shadow Brush="#E0E0E0"
                                            Offset="0,4"
                                            Radius="10"
                                            Opacity="0.3"/>
                                </Border.Shadow>

                                <Grid ColumnDefinitions="100,*"
                                    ColumnSpacing="15">

                                    <!-- Ảnh tạm -->
                                    <Image Source="{Binding PrimaryImage}"
                                        Aspect="AspectFill"
                                        HeightRequest="100"
                                        WidthRequest="100">
                                        <Image.Clip>
                                            <EllipseGeometry RadiusX="50"
                                                            RadiusY="50"
                                                            Center="50,50"/>
                                        </Image.Clip>
                                    </Image>

                                    <VerticalStackLayout Grid.Column="1"
                                                        Spacing="4">

                                        <!-- Tên -->
                                        <Label Text="{Binding Name}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="#1A1A1A"/>

                                        <!-- ID -->
                                        <!-- <Label Text="{Binding restaurantId,
                                                    StringFormat='ID: {0}'}"
                                            FontSize="11"
                                            TextColor="#9E9E9E"/> -->

                                        <!-- Địa chỉ -->
                                        <Label Text="{Binding Address}"
                                            FontSize="12"
                                            TextColor="#757575"/>

                                        <!-- Mô tả -->
                                        <Label Text="{Binding Description}"
                                            FontSize="12"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation"/>

                                        <!-- Toạ độ -->
                                        <!-- <Label FontSize="11"
                                            TextColor="#9E9E9E">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Lat: " />
                                                    <Span Text="{Binding Latitude}" />
                                                    <Span Text=" | Lng: " />
                                                    <Span Text="{Binding Longitude}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label> -->

                                        <!-- Trạng thái -->
                                        <Label FontSize="12" Text="Trạng thái: " TextColor="#757575" />
                                        <Label FontSize="12" Text="{Binding StatusText}" TextColor="{Binding IsCurrentlyOpen, Converter={StaticResource StatusToColorConverter}}" FontAttributes="Bold" />

                                        <!-- CreatedAt -->
                                        <!-- <Label Text="{Binding CreatedAt,
                                                    StringFormat='Tạo lúc: {0:dd/MM/yyyy HH:mm}'}"
                                            FontSize="11"
                                            TextColor="#9E9E9E"/> -->

                                        <!-- Audio file -->
                                        <!-- <Label Text="{Binding AudioFile,
                                                    StringFormat='Audio: {0}'}"
                                            FontSize="11"
                                            TextColor="#9E9E9E"/> -->

                                    </VerticalStackLayout>

                                </Grid>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Grid x:Name="PaginationContainer"
                      ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10"
                      IsVisible="False"
                      Margin="0,6,0,0">
                    <Button x:Name="PreviousPageButton"
                            Text="Trước"
                            Clicked="OnPreviousPageClicked"
                            BackgroundColor="#F5F1EE"
                            TextColor="#8D6E63"
                            CornerRadius="14"
                            FontSize="13"
                            HeightRequest="34"
                            Padding="14,0" />

                    <Label x:Name="PageIndicatorLabel"
                           Grid.Column="1"
                           Text="Trang 1/1"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           TextColor="#8D6E63"
                           FontSize="13"
                           FontAttributes="Bold" />

                    <Button x:Name="NextPageButton"
                            Grid.Column="2"
                            Text="Sau"
                            Clicked="OnNextPageClicked"
                            BackgroundColor="#F5F1EE"
                            TextColor="#8D6E63"
                            CornerRadius="14"
                            FontSize="13"
                            HeightRequest="34"
                            Padding="14,0" />
                </Grid>




            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Floating Button -->
            <Border x:Name="FloatingButton" IsVisible="False" StrokeThickness="0" BackgroundColor="#F48C06" StrokeShape="RoundRectangle 25" 
                HeightRequest="50" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,20" Padding="20,0">
                <Border.Shadow>
                 <Shadow Brush="#E65100" Offset="0,5" Radius="10" Opacity="0.4"/>
                </Border.Shadow>
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center" x:Name="NarratorButton">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNarratorTapped"/>
                        </HorizontalStackLayout.GestureRecognizers>
                        <Label Text="&#xf590;" FontFamily="FASolid" TextColor="White" FontSize="20" VerticalOptions="Center" />
                    <Label x:Name="NarratorText" Text="Bắt đầu thuyết minh tự động" TextColor="White" FontAttributes="Bold" FontSize="15" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- Bottom Navigation Bar -->

        <shared:BottomNavigationView 
            ActiveTab="Home"
            Grid.Row="1"/>


    </Grid>
</ContentPage>
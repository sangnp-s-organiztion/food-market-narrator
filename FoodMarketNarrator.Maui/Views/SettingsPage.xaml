<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:food_market_narrator.Views.Shared"
             x:Class="food_market_narrator.Views.SettingsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFCF8">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">
        <Grid Grid.Row="0" BackgroundColor="White" Padding="20,14" ColumnDefinitions="Auto,*">
            <Border StrokeThickness="0"
                    BackgroundColor="#FFF1E3"
                    HeightRequest="36"
                    WidthRequest="36"
                    StrokeShape="RoundRectangle 18"
                    VerticalOptions="Center">
                <Label Text="&#xf060;"
                       FontFamily="FASolid"
                       FontSize="13"
                       TextColor="#F48C06"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

            <Label Grid.Column="1"
                   Text="Cài đặt"
                   FontSize="30"
                   FontFamily="OpenSansSemibold"
                   TextColor="#1F2937"
                   Margin="12,0,0,0"
                   VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16,14,16,100" Spacing="16">
                <Border BackgroundColor="White"
                        Stroke="#F3ECE5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 28"
                        Padding="20,18">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border StrokeThickness="0"
                                BackgroundColor="#FFF1E3"
                                HeightRequest="44"
                                WidthRequest="44"
                                StrokeShape="RoundRectangle 22"
                                HorizontalOptions="Center">
                            <Label Text="&#xf007;"
                                   FontFamily="FASolid"
                                   FontSize="16"
                                   TextColor="#F48C06"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <Label Text="Chào mừng bạn!"
                               FontSize="28"
                               FontFamily="OpenSansSemibold"
                               TextColor="#1F2937"
                               HorizontalOptions="Center"/>

                        <Label Text="Đăng nhập để đồng bộ đơn hàng và nhận nhiều ưu đãi hơn."
                               FontSize="13"
                               TextColor="#94A3B8"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"/>

                        <Button Text="&#xf2f6;  Đăng nhập"
                                FontFamily="FASolid"
                                BackgroundColor="#F48C06"
                                TextColor="White"
                                FontSize="15"
                                FontAttributes="Bold"
                                CornerRadius="20"
                                HeightRequest="44"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="ỨNG DỤNG"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#A8B3C3"
                       Margin="6,0,0,0"/>

                <Border BackgroundColor="White"
                        Stroke="#F3ECE5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="14,6">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="0,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border StrokeThickness="0" BackgroundColor="#FFF1E3" HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                                <Label Text="&#xf57d;" FontFamily="FASolid" FontSize="12" TextColor="#F48C06" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="Ngôn ngữ" FontSize="15" TextColor="#1F2937" VerticalOptions="Center"/>
                            <Label Grid.Column="2" x:Name="CurrentLanguageLabel" Text="Tiếng Việt" FontSize="14" TextColor="#F48C06" VerticalOptions="Center" HorizontalOptions="End"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLanguageTapped"/>
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F3ECE5"/>

                        <Grid Padding="0,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border StrokeThickness="0" BackgroundColor="#FFF1E3" HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                                <Label Text="&#xf0f3;" FontFamily="FASolid" FontSize="12" TextColor="#F48C06" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="Thông báo" FontSize="15" TextColor="#1F2937" VerticalOptions="Center"/>
                            <Switch Grid.Column="2" IsToggled="True" OnColor="#F48C06" ThumbColor="White" VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F3ECE5"/>

                        <Grid Padding="0,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border StrokeThickness="0" BackgroundColor="#FFF1E3" HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                                <Label Text="&#xf3c5;" FontFamily="FASolid" FontSize="12" TextColor="#F48C06" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Vị trí nền" FontSize="15" TextColor="#1F2937"/>
                                <Label x:Name="BackgroundPermissionStatusLabel" Text="Chưa kiểm tra" FontSize="12" TextColor="#94A3B8"/>
                            </VerticalStackLayout>
                            <Switch x:Name="BackgroundPermissionSwitch"
                                    Grid.Column="2"
                                    IsToggled="False"
                                    Toggled="OnBackgroundLocationToggled"
                                    OnColor="#F48C06"
                                    ThumbColor="White"
                                    VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F3ECE5"/>

                        <Grid Padding="0,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border StrokeThickness="0" BackgroundColor="#FFF1E3" HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                                <Label Text="&#xf186;" FontFamily="FASolid" FontSize="12" TextColor="#F48C06" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="Chế độ tối" FontSize="15" TextColor="#1F2937" VerticalOptions="Center"/>
                            <Switch Grid.Column="2" IsToggled="False" OnColor="#F48C06" ThumbColor="White" VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="DỮ LIỆU"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#A8B3C3"
                       Margin="6,0,0,0"/>

                <Border BackgroundColor="White"
                        Stroke="#F3ECE5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="14,6">
                    <VerticalStackLayout Spacing="14" Padding="0,8,0,4">
                        <Border BackgroundColor="#FFFCF8"
                                Stroke="#F3ECE5"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 22"
                                Padding="14,14,14,12">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Quản lý bộ nhớ"
                                               FontSize="18"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="#1F2937"/>
                                        <Label Text="Bao gồm bản đồ ngoại tuyến, hình ảnh và dữ liệu âm thanh."
                                               FontSize="13"
                                               TextColor="#6B7280"
                                               LineBreakMode="WordWrap"/>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="End" VerticalOptions="Center">
                                        <Label x:Name="StorageTotalSizeLabel"
                                               Text="0 B"
                                               FontSize="26"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="#8A5A00"
                                               HorizontalTextAlignment="End"/>
                                        <Label Text="ĐÃ SỬ DỤNG"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#9CA3AF"
                                               HorizontalTextAlignment="End"/>
                                    </VerticalStackLayout>
                                </Grid>

                                <Border BackgroundColor="#ECECEC"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        HeightRequest="14">
                                    <Grid ColumnSpacing="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="MapSegmentColumn" Width="0*"/>
                                            <ColumnDefinition x:Name="ImageSegmentColumn" Width="0*"/>
                                            <ColumnDefinition x:Name="OtherSegmentColumn" Width="0*"/>
                                            <ColumnDefinition x:Name="UnusedSegmentColumn" Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" BackgroundColor="#F2A315" StrokeThickness="0" StrokeShape="RoundRectangle 8,0,0,8"/>
                                        <Border Grid.Column="1" BackgroundColor="#8A5A00" StrokeThickness="0"/>
                                        <Border Grid.Column="2" BackgroundColor="#E2C9A3" StrokeThickness="0"/>
                                        <Border Grid.Column="3" BackgroundColor="#ECECEC" StrokeThickness="0" StrokeShape="RoundRectangle 0,8,8,0"/>
                                    </Grid>
                                </Border>

                                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="18">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="●" TextColor="#F2A315" FontSize="12" VerticalTextAlignment="Center"/>
                                        <Label x:Name="StorageMapLegendLabel" Text="Bản đồ" FontSize="13" TextColor="#6B7280"/>
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                        <Label Text="●" TextColor="#8A5A00" FontSize="12" VerticalTextAlignment="Center"/>
                                        <Label x:Name="StorageImageLegendLabel" Text="Ảnh" FontSize="13" TextColor="#6B7280"/>
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="2" Spacing="6">
                                        <Label Text="●" TextColor="#E2C9A3" FontSize="12" VerticalTextAlignment="Center"/>
                                        <Label x:Name="StorageOtherLegendLabel" Text="Khác" FontSize="13" TextColor="#6B7280"/>
                                    </HorizontalStackLayout>
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Button Grid.Column="0"
                                            Text="&#xf2ed;  Xóa tất cả"
                                            FontFamily="FASolid"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            Clicked="OnClearAllDataClicked"
                                            BackgroundColor="#F2A3A7"
                                            TextColor="#7F1D1D"
                                            CornerRadius="20"
                                            HeightRequest="44"/>
                                    <Button Grid.Column="1"
                                            Text="Chi tiết"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            Clicked="OnStorageDetailsClicked"
                                            BackgroundColor="#ECEBE8"
                                            TextColor="#334155"
                                            CornerRadius="20"
                                            HeightRequest="44"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <BoxView HeightRequest="1" Color="#F3ECE5"/>

                        <Grid Padding="0,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border StrokeThickness="0" BackgroundColor="#FFF1E3" HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                                <Label Text="&#xf1da;" FontFamily="FASolid" FontSize="12" TextColor="#F48C06" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="Xóa lịch sử xem" FontSize="15" TextColor="#1F2937" VerticalOptions="Center"/>
                            <Button Grid.Column="2" Text="Xóa" Clicked="OnClearHistoryClicked"
                                    BackgroundColor="#FFE8EA" TextColor="#E57373" FontSize="12"
                                    CornerRadius="12" HeightRequest="32" Padding="12,0" VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F3ECE5"/>

                        <Grid Padding="0,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border StrokeThickness="0" BackgroundColor="#FFF1E3" HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                                <Label Text="&#xf004;" FontFamily="FASolid" FontSize="12" TextColor="#F48C06" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="Xóa yêu thích" FontSize="15" TextColor="#1F2937" VerticalOptions="Center"/>
                            <Button Grid.Column="2" Text="Xóa" Clicked="OnClearFavoritesClicked"
                                    BackgroundColor="#FFE8EA" TextColor="#E57373" FontSize="12"
                                    CornerRadius="12" HeightRequest="32" Padding="12,0" VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="HỖ TRỢ"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#A8B3C3"
                       Margin="6,0,0,0"/>

                <Border BackgroundColor="White"
                        Stroke="#F3ECE5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="14,6">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="0,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border StrokeThickness="0" BackgroundColor="#FFF1E3" HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                                <Label Text="&#xf059;" FontFamily="FASolid" FontSize="12" TextColor="#F48C06" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="Trung tâm trợ giúp" FontSize="15" TextColor="#1F2937" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="&#xf054;" FontFamily="FASolid" FontSize="12" TextColor="#94A3B8" VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F3ECE5"/>

                        <Grid Padding="0,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border StrokeThickness="0" BackgroundColor="#FFF1E3" HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                                <Label Text="&#xf3ed;" FontFamily="FASolid" FontSize="12" TextColor="#F48C06" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="Chính sách bảo mật" FontSize="15" TextColor="#1F2937" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="&#xf054;" FontFamily="FASolid" FontSize="12" TextColor="#94A3B8" VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F3ECE5"/>

                        <Grid Padding="0,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border StrokeThickness="0" BackgroundColor="#FFF1E3" HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                                <Label Text="&#xf15c;" FontFamily="FASolid" FontSize="12" TextColor="#F48C06" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="Điều khoản sử dụng" FontSize="15" TextColor="#1F2937" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="&#xf054;" FontFamily="FASolid" FontSize="12" TextColor="#94A3B8" VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!--
                <Button Text="&#xf2f5;  Đăng xuất"
                    FontFamily="FASolid"
                    TextColor="#EF4444"
                    BackgroundColor="#FFF5F5"
                    BorderColor="#FEE2E2"
                    BorderWidth="1"
                    FontSize="14"
                    FontAttributes="Bold"
                    CornerRadius="20"
                    HeightRequest="42"/>
                -->
            </VerticalStackLayout>
        </ScrollView>

        <shared:BottomNavigationView Grid.Row="2" ActiveTab="Setting"/>
    </Grid>
</ContentPage>

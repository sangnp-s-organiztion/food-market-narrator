<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:food_market_narrator.Views.Shared"
             xmlns:local="clr-namespace:food_market_narrator"
             x:Class="food_market_narrator.Views.SettingsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFCF8">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">
        <Grid Grid.Row="0" BackgroundColor="White" Padding="20,14" ColumnDefinitions="*">
            <!--
            <Border StrokeThickness="0"
                    BackgroundColor="#FFF1E3"
                    HeightRequest="36"
                    WidthRequest="36"
                    StrokeShape="RoundRectangle 18"
                    VerticalOptions="Center">
                <Label Text="&#xf060;"
                       FontFamily="FASolid"
                       FontSize="13"
                       TextColor="#F48C06"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>
            -->

            <Label Grid.Column="0"
                     Text="{local:Translate Settings}"
                   FontSize="30"
                   FontFamily="OpenSansSemibold"
                   TextColor="#1F2937"
                   Margin="0"
                   VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16,14,16,100" Spacing="16">
                <Border BackgroundColor="#F57C00"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 34"
                        Padding="22,18,22,20">
                    <Grid>
                        <Border StrokeThickness="0"
                                BackgroundColor="#D86C00"
                                Opacity="0.55"
                                HeightRequest="92"
                                WidthRequest="92"
                                StrokeShape="RoundRectangle 46"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="0,-20,-18,0"/>

                        <VerticalStackLayout Spacing="11">
                            <HorizontalStackLayout Spacing="8">
                                <Border StrokeThickness="0"
                                        BackgroundColor="#F8A74D"
                                        HeightRequest="28"
                                        WidthRequest="28"
                                        StrokeShape="RoundRectangle 14"
                                        VerticalOptions="Center">
                                    <Label Text="&#xf0eb;"
                                           FontFamily="FASolid"
                                           FontSize="12"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                                <Label Text="{local:Translate TodaysTip}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#FFE4BF"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <Label Text="{local:Translate TipTitle}"
                                FontSize="19"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="White"
                                   LineHeight="1.15"/>

                            <Label Text="{local:Translate TipDescription}"
                                   FontSize="15"
                                   TextColor="#FFE7C9"
                                   LineBreakMode="WordWrap"/>

                            <Button Text="{local:Translate ExperienceNow}"
                                    BackgroundColor="White"
                                    TextColor="#E07400"
                                    FontSize="16"
                                    FontFamily="OpenSansSemibold"
                                    CornerRadius="24"
                                    HeightRequest="46"
                                    Clicked="OnOpenTourBannerClicked"
                                    HorizontalOptions="Start"
                                    Padding="20,0"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                  <Label Text="{local:Translate AppSection}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#A8B3C3"
                       Margin="6,0,0,0"/>

                <Border BackgroundColor="White"
                        Stroke="#F3ECE5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="14,6">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="0,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border StrokeThickness="0" BackgroundColor="#FFF1E3" HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                                <Label Text="&#xf57d;" FontFamily="FASolid" FontSize="12" TextColor="#F48C06" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="{local:Translate NarrationLanguage}" FontSize="15" TextColor="#1F2937" VerticalOptions="Center"/>
                            <Label Grid.Column="2" x:Name="CurrentLanguageLabel" Text="{local:Translate Vietnamese}" FontSize="14" TextColor="#F48C06" VerticalOptions="Center" HorizontalOptions="End"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLanguageTapped"/>
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F3ECE5"/>

                        <Grid Padding="0,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border StrokeThickness="0" BackgroundColor="#FFF1E3" HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                                <Label Text="&#xf0f3;" FontFamily="FASolid" FontSize="12" TextColor="#F48C06" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="{local:Translate Notifications}" FontSize="15" TextColor="#1F2937" VerticalOptions="Center"/>
                            <Switch Grid.Column="2" IsToggled="True" OnColor="#F48C06" ThumbColor="White" VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F3ECE5"/>

                        <Grid Padding="0,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border StrokeThickness="0" BackgroundColor="#FFF1E3" HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                                <Label Text="&#xf3c5;" FontFamily="FASolid" FontSize="12" TextColor="#F48C06" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="{local:Translate BackgroundLocation}" FontSize="15" TextColor="#1F2937" VerticalOptions="Center"/>
                            <Switch x:Name="BackgroundPermissionSwitch"
                                    Grid.Column="2"
                                    IsToggled="False"
                                    Toggled="OnBackgroundLocationToggled"
                                    OnColor="#F48C06"
                                    ThumbColor="White"
                                    VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F3ECE5"/>

                        <Grid Padding="0,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border StrokeThickness="0" BackgroundColor="#FFF1E3" HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                                <Label Text="&#xf186;" FontFamily="FASolid" FontSize="12" TextColor="#F48C06" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="{local:Translate DarkMode}" FontSize="15" TextColor="#1F2937" VerticalOptions="Center"/>
                            <Switch Grid.Column="2" IsToggled="False" OnColor="#F48C06" ThumbColor="White" VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{local:Translate DataSection}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#A8B3C3"
                       Margin="6,0,0,0"/>

                <Border BackgroundColor="White"
                        Stroke="#F3ECE5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="14,6">
                    <VerticalStackLayout Spacing="14" Padding="0,8,0,4">
                        <Border BackgroundColor="#FFFCF8"
                                Stroke="#F3ECE5"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 22"
                                Padding="14,14,14,12">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="2">
                                                                                <Label Text="{local:Translate StorageManagement}"
                                               FontSize="18"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="#1F2937"/>
                                             <Label Text="{local:Translate StorageDescription}"
                                               FontSize="13"
                                               TextColor="#6B7280"
                                               LineBreakMode="WordWrap"/>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="End" VerticalOptions="Center">
                                        <Label x:Name="StorageTotalSizeLabel"
                                               Text="0 B"
                                               FontSize="26"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="#8A5A00"
                                               HorizontalTextAlignment="End"/>
                                             <Label Text="{local:Translate Used}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#9CA3AF"
                                               HorizontalTextAlignment="End"/>
                                    </VerticalStackLayout>
                                </Grid>

                                <Border BackgroundColor="#ECECEC"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        HeightRequest="14">
                                    <Grid ColumnSpacing="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="MapSegmentColumn" Width="0*"/>
                                            <ColumnDefinition x:Name="ImageSegmentColumn" Width="0*"/>
                                            <ColumnDefinition x:Name="OtherSegmentColumn" Width="0*"/>
                                            <ColumnDefinition x:Name="UnusedSegmentColumn" Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" BackgroundColor="#F2A315" StrokeThickness="0" StrokeShape="RoundRectangle 8,0,0,8"/>
                                        <Border Grid.Column="1" BackgroundColor="#8A5A00" StrokeThickness="0"/>
                                        <Border Grid.Column="2" BackgroundColor="#E2C9A3" StrokeThickness="0"/>
                                        <Border Grid.Column="3" BackgroundColor="#ECECEC" StrokeThickness="0" StrokeShape="RoundRectangle 0,8,8,0"/>
                                    </Grid>
                                </Border>

                                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="18">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="●" TextColor="#F2A315" FontSize="12" VerticalTextAlignment="Center"/>
                                        <Label x:Name="StorageMapLegendLabel" Text="{local:Translate MapLegend}" FontSize="13" TextColor="#6B7280"/>
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                        <Label Text="●" TextColor="#8A5A00" FontSize="12" VerticalTextAlignment="Center"/>
                                        <Label x:Name="StorageImageLegendLabel" Text="{local:Translate ImageLegend}" FontSize="13" TextColor="#6B7280"/>
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="2" Spacing="6">
                                        <Label Text="●" TextColor="#E2C9A3" FontSize="12" VerticalTextAlignment="Center"/>
                                        <Label x:Name="StorageOtherLegendLabel" Text="{local:Translate OtherLegend}" FontSize="13" TextColor="#6B7280"/>
                                    </HorizontalStackLayout>
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <Button Grid.Column="0"
                                            Text="{local:Translate ClearAll}"
                                            FontFamily="FASolid"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            Clicked="OnClearAllDataClicked"
                                            BackgroundColor="#F2A3A7"
                                            TextColor="#7F1D1D"
                                            CornerRadius="20"
                                            HeightRequest="44"/>
                                        <Button Grid.Column="1"
                                            Text="{local:Translate Details}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            Clicked="OnStorageDetailsClicked"
                                            BackgroundColor="#ECEBE8"
                                            TextColor="#334155"
                                            CornerRadius="20"
                                            HeightRequest="44"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <BoxView HeightRequest="1" Color="#F3ECE5"/>

                        <Grid Padding="0,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenHistoryTapped"/>
                            </Grid.GestureRecognizers>
                            <Border StrokeThickness="0" BackgroundColor="#FFF1E3" HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                                <Label Text="&#xf1da;" FontFamily="FASolid" FontSize="12" TextColor="#F48C06" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="{local:Translate ListeningHistory}" FontSize="15" TextColor="#1F2937" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="&#xf054;" FontFamily="FASolid" FontSize="12" TextColor="#94A3B8" VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F3ECE5"/>

                        <Grid Padding="0,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border StrokeThickness="0" BackgroundColor="#FFF1E3" HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                                <Label Text="&#xf1da;" FontFamily="FASolid" FontSize="12" TextColor="#F48C06" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                                <Label Grid.Column="1" Text="{local:Translate ClearListeningHistory}" FontSize="15" TextColor="#1F2937" VerticalOptions="Center"/>
                                <Button Grid.Column="2" Text="{local:Translate BtnClear}" Clicked="OnClearHistoryClicked"
                                    BackgroundColor="#FFE8EA" TextColor="#E57373" FontSize="12"
                                    CornerRadius="12" HeightRequest="32" Padding="12,0" VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F3ECE5"/>

                        <Grid Padding="0,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border StrokeThickness="0" BackgroundColor="#FFF1E3" HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                                <Label Text="&#xf004;" FontFamily="FASolid" FontSize="12" TextColor="#F48C06" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="{local:Translate ClearFavorites}" FontSize="15" TextColor="#1F2937" VerticalOptions="Center"/>
                            <Button Grid.Column="2" Text="{local:Translate BtnClear}" Clicked="OnClearFavoritesClicked"
                                    BackgroundColor="#FFE8EA" TextColor="#E57373" FontSize="12"
                                    CornerRadius="12" HeightRequest="32" Padding="12,0" VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{local:Translate SupportSection}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#A8B3C3"
                       Margin="6,0,0,0"/>

                <Border BackgroundColor="White"
                        Stroke="#F3ECE5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="14,6">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="0,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border StrokeThickness="0" BackgroundColor="#FFF1E3" HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                                <Label Text="&#xf059;" FontFamily="FASolid" FontSize="12" TextColor="#F48C06" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="{local:Translate HelpCenter}" FontSize="15" TextColor="#1F2937" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="&#xf054;" FontFamily="FASolid" FontSize="12" TextColor="#94A3B8" VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F3ECE5"/>

                        <Grid Padding="0,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border StrokeThickness="0" BackgroundColor="#FFF1E3" HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                                <Label Text="&#xf3ed;" FontFamily="FASolid" FontSize="12" TextColor="#F48C06" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="{local:Translate PrivacyPolicy}" FontSize="15" TextColor="#1F2937" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="&#xf054;" FontFamily="FASolid" FontSize="12" TextColor="#94A3B8" VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F3ECE5"/>

                        <Grid Padding="0,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border StrokeThickness="0" BackgroundColor="#FFF1E3" HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                                <Label Text="&#xf15c;" FontFamily="FASolid" FontSize="12" TextColor="#F48C06" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="{local:Translate TermsOfService}" FontSize="15" TextColor="#1F2937" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="&#xf054;" FontFamily="FASolid" FontSize="12" TextColor="#94A3B8" VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!--
                <Button Text="&#xf2f5;  Đăng xuất"
                    FontFamily="FASolid"
                    TextColor="#EF4444"
                    BackgroundColor="#FFF5F5"
                    BorderColor="#FEE2E2"
                    BorderWidth="1"
                    FontSize="14"
                    FontAttributes="Bold"
                    CornerRadius="20"
                    HeightRequest="42"/>
                -->
            </VerticalStackLayout>
        </ScrollView>

        <shared:BottomNavigationView Grid.Row="2" ActiveTab="Setting"/>
    </Grid>
</ContentPage>

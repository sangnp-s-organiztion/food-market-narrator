<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:food_market_narrator.Models"
             x:Class="food_market_narrator.Views.POIDetailPage"
             x:DataType="models:POI"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#EEEEEE">
    <Grid RowDefinitions="*,Auto" RowSpacing="0">
        <!-- Khu vực nội dung chính có thể cuộn -->
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="18" Padding="14,10,14,24">

                <!-- Cụm đầu trang: ảnh cover + card thông tin quán -->
                <Grid RowDefinitions="220,Auto">
                    <!-- Ảnh cover + nhóm icon điều hướng/tương tác ở trên ảnh -->
                    <Border Grid.Row="0"
                            StrokeThickness="0"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 18"
                            HeightRequest="220">
                        <Grid>
                            <Image Source="{Binding PrimaryDetailImage}" Aspect="AspectFill" />

                            <Grid Padding="14,14,14,0" ColumnDefinitions="Auto,*,Auto,Auto" VerticalOptions="Start" ColumnSpacing="8">
                                <Border StrokeThickness="0"
                                        BackgroundColor="#B0B0B0"
                                        HeightRequest="34"
                                        WidthRequest="34"
                                        StrokeShape="RoundRectangle 17">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnBackButtonTapped"/>
                                    </Border.GestureRecognizers>
                                    <!-- Button back -->
                                    <Label Text="&#xf060;"
                                           FontFamily="FASolid"
                                           FontSize="14"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <Label Grid.Column="1" />

                                <Border Grid.Column="2"
                                        StrokeThickness="0"
                                        BackgroundColor="#B0B0B0"
                                        HeightRequest="34"
                                        WidthRequest="34"
                                        StrokeShape="RoundRectangle 17">
                                    <!-- Button favorite -->
                                    <Label x:Name="FavoriteIcon"
                                           Text="&#xf004;"
                                           FontFamily="FASolid"
                                           FontSize="14"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnFavoriteTapped"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Border>

                                <Border Grid.Column="3"
                                        StrokeThickness="0"
                                        BackgroundColor="#B0B0B0"
                                        HeightRequest="34"
                                        WidthRequest="34"
                                        StrokeShape="RoundRectangle 17">
                                    <!-- Button share -->
                                    <Label Text="&#xf1e0;"
                                           FontFamily="FASolid"
                                           FontSize="14"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Card thông tin quán (trạng thái, giờ mở cửa, tên, rating, địa chỉ) -->
                    <Border Grid.Row="1"
                            Margin="16,-44,16,0"
                            Padding="14"
                            StrokeThickness="0"
                            BackgroundColor="#F8F7F4"
                            StrokeShape="RoundRectangle 28">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Border StrokeThickness="0"
                                        BackgroundColor="{Binding IsCurrentlyOpen, Converter={StaticResource StatusToColorConverter}, ConverterParameter=background}"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="8,2">
                                    <Label Text="{Binding StatusText}"
                                         FontSize="10"
                                         FontAttributes="Bold"
                                         TextColor="{Binding IsCurrentlyOpen, Converter={StaticResource StatusToColorConverter}}"
                                         HorizontalTextAlignment="Center"
                                         VerticalTextAlignment="Center" />
                                </Border>
                                <Label Grid.Column="1"
                                    Text="{Binding OpeningHoursDisplay}"
                                       VerticalOptions="Center"
                                       FontSize="13"
                                       TextColor="#7A7A7A" />
                                <Border Grid.Column="2"
                                        StrokeThickness="0"
                                        BackgroundColor="#2D6A5E"
                                        HeightRequest="40"
                                        WidthRequest="40"
                                        StrokeShape="RoundRectangle 20">
                                    <Label Text="&#xf017;"
                                           FontFamily="FASolid"
                                           FontSize="12"
                                           TextColor="#CFD8DC"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>

                            <Label Grid.Row="1"
                                   Text="{Binding Name}"
                                   FontSize="35"
                                   TextColor="#1B1F2A"
                                   LineBreakMode="WordWrap"
                                   FontFamily="OpenSansSemibold" />

                            <VerticalStackLayout Grid.Row="2" Spacing="6">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="&#xf005;" FontFamily="FASolid" FontSize="12" TextColor="#F39C12" />
                                    <Label Text="Chưa có" FontSize="13" FontAttributes="Bold" TextColor="#2F3640" />
                                    <Label Text="(chưa có đánh giá)" FontSize="12" TextColor="#808B96" />
                                </HorizontalStackLayout>
                                <!-- HARD_CODE: payload không có rating/review -->

                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="&#xf3c5;" FontFamily="FASolid" FontSize="12" TextColor="#E67E22" VerticalOptions="Start" Margin="0,2,0,0" />
                                    <Label Text="{Binding AddressDisplay}"
                                           FontSize="13"
                                           TextColor="#616A6B"
                                           LineBreakMode="WordWrap"
                                           MaxLines="2" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Khối Audio Guide: tiêu đề, nút play, tiến trình, waveform -->
                <Border BackgroundColor="#E7DDCF"
                        Stroke="#E8BF8A"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 26"
                        Padding="16,14"
                        Margin="8,0">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="10">
                            <Border StrokeThickness="0"
                                    BackgroundColor="#F39C12"
                                    HeightRequest="42"
                                    WidthRequest="42"
                                    StrokeShape="RoundRectangle 21">
                                <Label Text="&#xf025;"
                                       FontFamily="FASolid"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="18" />
                            </Border>
                            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                <Label Text="Thuyết minh" FontSize="29" FontAttributes="Bold" TextColor="#1B1F2A" />
                                <!-- <Label Text="{Binding Description}" FontSize="12" TextColor="#6B7280" LineBreakMode="WordWrap" MaxLines="2" /> -->
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <Label 
                            Text="- Nghe thuyết minh để tìm hiểu thêm về quán, không gian và các món đặc trưng. Mang đến trải nghiệm khám phá sống động.&#10;- Nội dung hỗ trợ tiếng Việt, tiếng Anh, tiếng Trung, tiếng Nhật, tiếng Hàn."
                            FontSize="13"
                            TextColor="#6B7280"
                            LineBreakMode="WordWrap" />



                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border x:Name="PlayAudioButton"
                                StrokeThickness="0"
                                    BackgroundColor="#F39C12"
                                    HeightRequest="42"
                                    WidthRequest="42"
                                    StrokeShape="RoundRectangle 21">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPlayAudioTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="&#xf04b;"
                                       x:Name="PlayIconLabel"
                                       FontFamily="FASolid"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Margin="2,0,0,0"
                                       FontSize="14" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="False">
                                    <Label x:Name="CurrentTimeLabel" Text="00:00" FontSize="10" TextColor="#8D8D8D" />
                                    <Label x:Name="TotalTimeLabel" Grid.Column="2" Text="00:00" FontSize="10" TextColor="#8D8D8D" HorizontalTextAlignment="End" />
                                </Grid>
                                <ProgressBar x:Name="AudioProgressBar"
                                             HeightRequest="6"
                                             Progress="0"
                                             ProgressColor="#F39C12"
                                             BackgroundColor="#D6DBDF" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                <BoxView WidthRequest="2" HeightRequest="6" Color="#E8B878" VerticalOptions="End" />
                                <BoxView WidthRequest="2" HeightRequest="12" Color="#E8B878" VerticalOptions="End" />
                                <BoxView WidthRequest="2" HeightRequest="8" Color="#E8B878" VerticalOptions="End" />
                                <BoxView WidthRequest="2" HeightRequest="16" Color="#E8B878" VerticalOptions="End" />
                                <BoxView WidthRequest="2" HeightRequest="10" Color="#E8B878" VerticalOptions="End" />
                                <BoxView WidthRequest="2" HeightRequest="15" Color="#E8B878" VerticalOptions="End" />
                                <BoxView WidthRequest="2" HeightRequest="9" Color="#E8B878" VerticalOptions="End" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Header phần thực đơn -->
                <Grid Padding="10,0,10,0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label Text="Thực đơn"
                           FontSize="32"
                           FontFamily="OpenSansSemibold"
                           TextColor="#1F2937" />
                    <Label Grid.Column="1"
                           Text="Xem tất cả"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#F39C12"
                           VerticalOptions="Center" />
                </Grid>

                <!-- Danh sách món ăn dạng cuộn ngang -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Dishes}" Spacing="12" Padding="10,0,10,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:DishModel">
                                <VerticalStackLayout WidthRequest="150" Spacing="6">
                                    <!-- Ảnh món ăn / placeholder -->
                                    <Border StrokeThickness="0"
                                            StrokeShape="RoundRectangle 20"
                                            HeightRequest="150"
                                            WidthRequest="150"
                                            BackgroundColor="#FFE0B2">
                                        <Grid>
                                            <!-- Placeholder icon (hiển thị khi không có ảnh) -->
                                            <!-- <Label Text="🍜"
                                                   FontSize="48"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding ImageFileName, Converter={StaticResource NullOrEmptyToVisibilityConverter}, ConverterParameter=inverse, FallbackValue=True}" /> -->
                                            <!-- Ảnh món ăn (bind ImageResourceName — đã strip extension) -->
                                            <Image Source="{Binding ImageResourceName}"
                                                   Aspect="AspectFill"
                                                   IsVisible="{Binding ImageResourceName, Converter={StaticResource NullOrEmptyToVisibilityConverter}, ConverterParameter=inverse, FallbackValue=False}" />
                                        </Grid>
                                    </Border>

                                    <!-- Tên món ăn -->
                                    <Label Text="{Binding Name}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#2F3640"
                                           MaxLines="2"
                                           LineBreakMode="WordWrap" />

                                    <!-- Giá món ăn -->
                                    <Label Text="{Binding Price, StringFormat='{}{0:N0} đ'}"
                                           FontSize="13"
                                           TextColor="#E67E22"
                                           FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Phần giới thiệu / mô tả về quán -->
                <VerticalStackLayout Spacing="8" Padding="10,0,10,0">
                    <Label Text="Về chúng tôi"
                           FontSize="30"
                           FontFamily="OpenSansSemibold"
                           TextColor="#1F2937" />
                      <Label Text="{Binding Description}"
                           FontSize="13"
                           TextColor="#6B7280"
                           LineHeight="1.4" />

                      <!-- <Label Text="{Binding restaurantId, StringFormat='Mã quán: {0}'}"
                          FontSize="12"
                          TextColor="#6B7280" /> -->
                      <!-- <Label Text="{Binding CoordinatesDisplay, StringFormat='Tọa độ: {0}'}"
                          FontSize="12"
                          TextColor="#6B7280" /> -->
                      <Label Text="{Binding CreatedAtDisplay, StringFormat='Ngày mở bán: {0}'}"
                          FontSize="12"
                          TextColor="#6B7280" />
                      <!-- <Label Text="{Binding AudioSummaryDisplay}"
                          FontSize="12"
                          TextColor="#6B7280"
                          LineBreakMode="WordWrap" /> -->
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Thanh CTA cố định dưới cùng: Đường đi + Gọi điện -->
        <Grid Grid.Row="1" BackgroundColor="#EEEEEE" Padding="14,10,14,16" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Grid.Column="0"
                    x:Name="BtnGetDirection"
                    Text="Đường đi"
                    FontAttributes="Bold"
                    TextColor="#F39C12"
                    BackgroundColor="White"
                    BorderColor="#F39C12"
                    BorderWidth="1"
                    CornerRadius="24"
                    Clicked="OnGetDirectionClicked">
                <Button.ImageSource>
                    <FontImageSource Glyph="&#xf5eb;" FontFamily="FASolid" Size="14" Color="#F39C12" />
                </Button.ImageSource>
            </Button>

            <Button Grid.Column="1"
                    x:Name="BtnCallNow"
                    Text="Gọi điện ngay"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#F39C12"
                    CornerRadius="24"
                    Clicked="OnCallNowClicked">
                <Button.ImageSource>
                    <FontImageSource Glyph="&#xf095;" FontFamily="FASolid" Size="14" Color="White" />
                </Button.ImageSource>
            </Button>
        </Grid>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="food_market_narrator.AppShell"
    xmlns:views="clr-namespace:food_market_narrator.Views"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:food_market_narrator"
    Title="{local:Translate AppTitle}">

    <ShellContent
        Title="{local:Translate TabHome}"
        ContentTemplate="{DataTemplate views:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="{local:Translate TabMap}"
        ContentTemplate="{DataTemplate views:MapPage}"
        Route="MapPage" />

    <ShellContent
        Title="{local:Translate TabTour}"
        ContentTemplate="{DataTemplate views:TourPage}"
        Route="TourPage" />

    <ShellContent
        Title="{local:Translate TabFavorite}"
        ContentTemplate="{DataTemplate views:FavoritePage}"
        Route="FavoritePage" />

    <ShellContent
        Title="{local:Translate TabHistory}"
        ContentTemplate="{DataTemplate views:HistoryPage}"
        Route="HistoryPage" />

    <ShellContent
        Title="{local:Translate TabSettings}"
        ContentTemplate="{DataTemplate views:SettingsPage}"
        Route="SettingsPage" />

</Shell>

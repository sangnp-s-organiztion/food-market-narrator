<article class="panel rejection-box">
    <h3>Rejection Details</h3>
    <label>Rejection Reason</label>
    <textarea rows="4" placeholder="Explain why the POI is being rejected..."></textarea>
    <div class="reject-footer">
        <small>Visible to seller only</small>
        <button class="dark-btn" type="button">Confirm Rejection</button>
    </div>
</article>

<div class="kpi-grid">
    <article class="kpi-card warning"><h3>12</h3><p>Pending</p></article>
    <article class="kpi-card success"><h3>45</h3><p>Approved Today</p></article>
    <article class="kpi-card danger"><h3>8</h3><p>Rejected Today</p></article>
</div>

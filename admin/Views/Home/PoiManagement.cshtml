@section TopbarActions {
    <input type="search" id="poiSearch" placeholder="Search POIs..." aria-label="Search POIs" />
    <button class="cta" id="openPoiModal" type="button">+ Add New POI</button>
}

<div class="section-title">
    <h2>Manage Street Locations</h2>
    <p>Review, update, and monitor all points of interest on Vinh Khanh street.</p>
</div>

<div class="chip-row">
    <button class="chip active" type="button">All POIs</button>
    <button class="chip" type="button">Restaurants</button>
    <button class="chip" type="button">Street Stalls</button>
    <button class="chip" type="button">Landmarks</button>
</div>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>POI Name</th>
                <th>Category</th>
                <th>Status</th>
                <th>Last Updated</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="poiTableBody"></tbody>
    </table>
</div>

<div class="kpi-grid">
    <article class="kpi-card success"><h3 id="activePoiCount">0</h3><p>Active Points of Interest</p></article>
    <article class="kpi-card warning"><h3 id="pendingPoiCount">0</h3><p>Pending Approvals</p></article>
    <article class="kpi-card danger"><h3 id="flaggedPoiCount">0</h3><p>Flagged for Review</p></article>
</div>

<div class="modal-backdrop" id="poiModalBackdrop" hidden>
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="poiModalTitle">
        <div class="modal-head">
            <h3 id="poiModalTitle">Add New POI</h3>
            <button class="icon-btn" id="closePoiModal" type="button" aria-label="Close">x</button>
        </div>

        <form id="poiForm" novalidate>
            <input type="hidden" id="poiId" />

            <label for="poiName">POI Name</label>
            <input id="poiName" type="text" maxlength="80" />
            <small class="field-error" data-error-for="poiName"></small>

            <label for="poiAddress">Address</label>
            <input id="poiAddress" type="text" maxlength="120" />
            <small class="field-error" data-error-for="poiAddress"></small>

            <div class="form-split">
                <div>
                    <label for="poiCategory">Category</label>
                    <select id="poiCategory">
                        <option value="">Select category</option>
                        <option value="Restaurant">Restaurant</option>
                        <option value="Stall">Stall</option>
                        <option value="Landmark">Landmark</option>
                    </select>
                    <small class="field-error" data-error-for="poiCategory"></small>
                </div>
                <div>
                    <label for="poiStatus">Status</label>
                    <select id="poiStatus">
                        <option value="">Select status</option>
                        <option value="Active">Active</option>
                        <option value="Pending">Pending</option>
                        <option value="Flagged">Flagged</option>
                    </select>
                    <small class="field-error" data-error-for="poiStatus"></small>
                </div>
            </div>

            <div class="modal-actions">
                <button class="ghost-btn" id="cancelPoiModal" type="button">Cancel</button>
                <button class="cta" type="submit" id="savePoiButton">Save POI</button>
            </div>
        </form>
    </div>
</div>

<div class="modal-backdrop" id="deleteModalBackdrop" hidden>
    <div class="modal-card modal-sm" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
        <h3 id="deleteModalTitle">Delete POI</h3>
        <p class="modal-message" id="deleteModalMessage">Are you sure you want to delete this POI?</p>
        <div class="modal-actions">
            <button class="ghost-btn" id="cancelDeletePoi" type="button">Cancel</button>
            <button class="reject" id="confirmDeletePoi" type="button">Delete</button>
        </div>
    </div>
</div>

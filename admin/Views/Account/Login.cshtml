@model admin.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Vinh Khanh Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Sora:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/auth/login.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-shell">
        <section class="auth-panel">
            <div class="brand">
                <span class="brand-icon">VF</span>
                <div>
                    <h1>Vinh Khanh Admin</h1>
                    <p>Food Street Portal</p>
                </div>
            </div>

            <h2>Sign In</h2>
            <p class="subtitle">Use admin credentials to continue.</p>

            <form asp-controller="Account" asp-action="Login" method="post" class="login-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div asp-validation-summary="ModelOnly" class="error-box"></div>

                <label asp-for="Username"></label>
                <input asp-for="Username" autocomplete="username" />
                <span asp-validation-for="Username" class="field-error"></span>

                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-error"></span>

                <label class="remember-me">
                    <input asp-for="RememberMe" /> Keep me signed in
                </label>

                <button type="submit">Sign In</button>
            </form>

            <p class="hint">Default: admin / admin123 (change in appsettings via AdminLogin).</p>
        </section>
    </div>
</body>
</html>

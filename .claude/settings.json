{
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet ef *)",
      "Bash(npm run build *)",
      "Bash(npm run dev *)",
      "Bash(npm run lint *)",
      "Bash(npm test *)",
      "Bash(npx *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git show *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh run *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "mcp__microsoft-learn__*",
      "mcp__context7__*",
      "mcp__plugin_playwright__*"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git branch -D *)",
      "Bash(dotnet add package *)",
      "Bash(dotnet nuget *)",
      "Read(.env*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*/credentials*)",
      "Read(**/secret*)",
      "Write(.env*)",
      "Write(*.pem)",
      "Write(*.key)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-edit-lint.mjs"
          }
        ]
      }
    ]
  }
}

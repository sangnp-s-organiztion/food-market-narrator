        <mxCell id="3" value="Khối 2: Đăng nhập và quên mật khẩu" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;dashed=1;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="250" y="470" width="700" height="770" as="geometry" /></mxCell>

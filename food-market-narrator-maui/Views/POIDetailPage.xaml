<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="food_market_narrator.Views.POIDetailPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#EEEEEE">
    <Grid RowDefinitions="*,Auto" RowSpacing="0">
        <!-- Khu vực nội dung chính có thể cuộn -->
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="18" Padding="14,10,14,24">

                <!-- Cụm đầu trang: ảnh cover + card thông tin quán -->
                <Grid RowDefinitions="220,Auto">
                    <!-- Ảnh cover + nhóm icon điều hướng/tương tác ở trên ảnh -->
                    <Border Grid.Row="0"
                            StrokeThickness="0"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 18"
                            HeightRequest="220">
                        <Grid>
                            <Image Source="oc_oanh.jpg" Aspect="AspectFill" />

                            <Grid Padding="14,14,14,0" ColumnDefinitions="Auto,*,Auto,Auto" VerticalOptions="Start" ColumnSpacing="8">
                                <Border StrokeThickness="0"
                                        BackgroundColor="#80FFFFFF"
                                        HeightRequest="34"
                                        WidthRequest="34"
                                        StrokeShape="RoundRectangle 17">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnBackButtonTapped"/>
                                    </Border.GestureRecognizers>
                                    <!-- Button back -->
                                    <Label Text="&#xf060;"
                                           FontFamily="FASolid"
                                           FontSize="14"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <Label Grid.Column="1" />

                                <Border Grid.Column="2"
                                        StrokeThickness="0"
                                        BackgroundColor="#80FFFFFF"
                                        HeightRequest="34"
                                        WidthRequest="34"
                                        StrokeShape="RoundRectangle 17">
                                    <!-- Button favorite -->
                                    <Label Text="&#xf004;"
                                           FontFamily="FASolid"
                                           FontSize="14"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <Border Grid.Column="3"
                                        StrokeThickness="0"
                                        BackgroundColor="#80FFFFFF"
                                        HeightRequest="34"
                                        WidthRequest="34"
                                        StrokeShape="RoundRectangle 17">
                                    <!-- Button share -->
                                    <Label Text="&#xf1e0;"
                                           FontFamily="FASolid"
                                           FontSize="14"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Card thông tin quán (trạng thái, giờ mở cửa, tên, rating, địa chỉ) -->
                    <Border Grid.Row="1"
                            Margin="16,-44,16,0"
                            Padding="14"
                            StrokeThickness="0"
                            BackgroundColor="#F8F7F4"
                            StrokeShape="RoundRectangle 28">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Border StrokeThickness="0"
                                        BackgroundColor="#C8E6C9"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="8,2">
                                    <Label Text="ĐANG MỞ CỬA"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="#2E7D32" />
                                </Border>
                                <Label Grid.Column="1"
                                       Text="13:00 - 23:00"
                                       VerticalOptions="Center"
                                       FontSize="13"
                                       TextColor="#7A7A7A" />
                                <Border Grid.Column="2"
                                        StrokeThickness="0"
                                        BackgroundColor="#2D6A5E"
                                        HeightRequest="40"
                                        WidthRequest="40"
                                        StrokeShape="RoundRectangle 20">
                                    <Label Text="&#xf017;"
                                           FontFamily="FASolid"
                                           FontSize="12"
                                           TextColor="#CFD8DC"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>

                            <Label Grid.Row="1"
                                   Text="Ốc Oanh - Vĩnh Khánh"
                                   FontSize="35"
                                   TextColor="#1B1F2A"
                                   LineBreakMode="WordWrap"
                                   FontFamily="OpenSansSemibold" />

                            <VerticalStackLayout Grid.Row="2" Spacing="6">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="&#xf005;" FontFamily="FASolid" FontSize="12" TextColor="#F39C12" />
                                    <Label Text="4.8" FontSize="13" FontAttributes="Bold" TextColor="#2F3640" />
                                    <Label Text="(1.2k+ đánh giá)" FontSize="12" TextColor="#808B96" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="&#xf3c5;" FontFamily="FASolid" FontSize="12" TextColor="#E67E22" VerticalOptions="Start" Margin="0,2,0,0" />
                                    <Label Text="534 Vĩnh Khánh, Phường 8, Quận 4, TP. Hồ Chí Minh"
                                           FontSize="13"
                                           TextColor="#616A6B"
                                           LineBreakMode="WordWrap"
                                           MaxLines="2" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Khối Audio Guide: tiêu đề, nút play, tiến trình, waveform -->
                <Border BackgroundColor="#E7DDCF"
                        Stroke="#E8BF8A"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 26"
                        Padding="16,14"
                        Margin="8,0">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="10">
                            <Border StrokeThickness="0"
                                    BackgroundColor="#F39C12"
                                    HeightRequest="42"
                                    WidthRequest="42"
                                    StrokeShape="RoundRectangle 21">
                                <Label Text="&#xf025;"
                                       FontFamily="FASolid"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="18" />
                            </Border>
                            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                <Label Text="Audio Guide" FontSize="29" FontAttributes="Bold" TextColor="#1B1F2A" />
                                <Label Text="Khám phá câu chuyện món Ốc tại Vĩnh Khánh" FontSize="12" TextColor="#6B7280" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border StrokeThickness="0"
                                    BackgroundColor="#F39C12"
                                    HeightRequest="42"
                                    WidthRequest="42"
                                    StrokeShape="RoundRectangle 21">
                                <Label Text="&#xf04b;"
                                       FontFamily="FASolid"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Margin="2,0,0,0"
                                       FontSize="14" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Label Text="01:12" FontSize="10" TextColor="#8D8D8D" />
                                    <Label Grid.Column="2" Text="03:45" FontSize="10" TextColor="#8D8D8D" HorizontalTextAlignment="End" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="0" HeightRequest="6">
                                    <Border StrokeThickness="0" BackgroundColor="#F39C12" StrokeShape="RoundRectangle 3" />
                                    <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="#D6DBDF" StrokeShape="RoundRectangle 3" />
                                </Grid>
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                <BoxView WidthRequest="2" HeightRequest="6" Color="#E8B878" VerticalOptions="End" />
                                <BoxView WidthRequest="2" HeightRequest="12" Color="#E8B878" VerticalOptions="End" />
                                <BoxView WidthRequest="2" HeightRequest="8" Color="#E8B878" VerticalOptions="End" />
                                <BoxView WidthRequest="2" HeightRequest="16" Color="#E8B878" VerticalOptions="End" />
                                <BoxView WidthRequest="2" HeightRequest="10" Color="#E8B878" VerticalOptions="End" />
                                <BoxView WidthRequest="2" HeightRequest="15" Color="#E8B878" VerticalOptions="End" />
                                <BoxView WidthRequest="2" HeightRequest="9" Color="#E8B878" VerticalOptions="End" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Header phần món ăn đặc sắc -->
                <Grid Padding="10,0,10,0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label Text="Món ăn đặc sắc"
                           FontSize="32"
                           FontFamily="OpenSansSemibold"
                           TextColor="#1F2937" />
                    <Label Grid.Column="1"
                           Text="Xem tất cả"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#F39C12"
                           VerticalOptions="Center" />
                </Grid>

                <!-- Danh sách món ăn dạng cuộn ngang -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="12" Padding="10,0,10,0">
                        <VerticalStackLayout WidthRequest="116" Spacing="6">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 28" HeightRequest="116" WidthRequest="116" BackgroundColor="#D5E1D6">
                                <Image Source="be_oc_2.PNG" Aspect="AspectFit" Margin="10" />
                            </Border>
                            <Label Text="Ốc hương trứng muối" FontSize="16" TextColor="#2F3640" MaxLines="2" />
                            <Label Text="125.000đ" FontSize="12" FontAttributes="Bold" TextColor="#E67E22" />
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="116" Spacing="6">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 28" HeightRequest="116" WidthRequest="116" BackgroundColor="#D8DBD2">
                                <Image Source="oc_hong_nhung.jpg" Aspect="AspectFill" />
                            </Border>
                            <Label Text="Càng ghẹ rang muối" FontSize="16" TextColor="#2F3640" MaxLines="2" />
                            <Label Text="145.000đ" FontSize="12" FontAttributes="Bold" TextColor="#E67E22" />
                        </VerticalStackLayout>

                        <VerticalStackLayout WidthRequest="116" Spacing="6">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 28" HeightRequest="116" WidthRequest="116" BackgroundColor="#D8DBD2">
                                <Image Source="oc_hoa_kieu.jpg" Aspect="AspectFill" />
                            </Border>
                            <Label Text="Sò điệp nướng mỡ hành" FontSize="16" TextColor="#2F3640" MaxLines="2" />
                            <Label Text="85.000đ" FontSize="12" FontAttributes="Bold" TextColor="#E67E22" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Phần giới thiệu / mô tả về quán -->
                <VerticalStackLayout Spacing="8" Padding="10,0,10,0">
                    <Label Text="Về chúng tôi"
                           FontSize="30"
                           FontFamily="OpenSansSemibold"
                           TextColor="#1F2937" />
                    <Label Text="Ốc Oanh là một trong những quán ốc nổi tiếng nhất tại phố ẩm thực Vĩnh Khánh. Với không gian mở náo nhiệt đặc trưng của Sài Gòn, cùng tối mang đến những món hải sản tươi ngon được chế biến đậm đà theo phong cách riêng biệt."
                           FontSize="13"
                           TextColor="#6B7280"
                           LineHeight="1.4" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Thanh CTA cố định dưới cùng: Đường đi + Gọi điện -->
        <Grid Grid.Row="1" BackgroundColor="#EEEEEE" Padding="14,10,14,16" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Grid.Column="0"
                    Text="Đường đi"
                    FontAttributes="Bold"
                    TextColor="#F39C12"
                    BackgroundColor="White"
                    BorderColor="#F39C12"
                    BorderWidth="1"
                    CornerRadius="24">
                <Button.ImageSource>
                    <FontImageSource Glyph="&#xf5eb;" FontFamily="FASolid" Size="14" Color="#F39C12" />
                </Button.ImageSource>
            </Button>

            <Button Grid.Column="1"
                    Text="Gọi điện ngay"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#F39C12"
                    CornerRadius="24">
                <Button.ImageSource>
                    <FontImageSource Glyph="&#xf095;" FontFamily="FASolid" Size="14" Color="White" />
                </Button.ImageSource>
            </Button>
        </Grid>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:food_market_narrator.Views.Shared"
             x:Class="food_market_narrator.Views.FavoritePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFCF8">
    <Grid RowDefinitions="Auto, *, Auto" RowSpacing="0">
        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="White" Padding="20,14" ColumnDefinitions="Auto,*">
            <Label Text="&#xf004;"
                   FontFamily="FASolid"
                   FontSize="18"
                   TextColor="#8D6E63"
                   VerticalOptions="Center"/>
            <Label Grid.Column="1"
                   Text="Yêu thích"
                   FontSize="30"
                   FontFamily="OpenSansSemibold"
                   TextColor="#1A1A1A"
                   Margin="12,0,0,0"
                   VerticalOptions="Center"/>
        </Grid>

        <!-- Empty state -->
        <VerticalStackLayout Grid.Row="1" x:Name="EmptyState" IsVisible="False" VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">
            <Label Text="&#xf004;" FontFamily="FASolid" FontSize="60" TextColor="#E0E0E0" HorizontalOptions="Center"/>
            <Label Text="Chưa có quán yêu thích" FontSize="16" TextColor="#9E9E9E" HorizontalOptions="Center"/>
            <Label Text="Nhấn vào biểu tượng trái tim để thêm" FontSize="13" TextColor="#BDBDBD" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- Danh sách yêu thích -->
        <ScrollView Grid.Row="1" x:Name="ListContainer" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="15" Spacing="10" x:Name="FavoriteListContainer">
                <!-- Items sẽ được thêm vào đây bằng code-behind -->
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Navigation -->
        <shared:BottomNavigationView
            Grid.Row="2"
            ActiveTab="Favorite" />
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:food_market_narrator.Views.Shared"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             x:Class="food_market_narrator.Views.MainPage"
             BackgroundColor="#FFFCF8"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto" RowSpacing="0">
        <Grid Grid.Row="0">
            <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="15" Padding="20,10,20,120">

                <!-- 1. Header -->
                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                    <!-- Icon placeholder -->
                    <Border Stroke="#FFF3E0" StrokeThickness="0" BackgroundColor="#FFF3E0" 
                            HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20">
                        <Label Text="&#xf2e7;" FontFamily="FASolid" TextColor="#F48C06" 
                               HorizontalOptions="Center" VerticalOptions="Center" FontSize="18"/>
                    </Border>

                    <!-- Title -->
                    <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center" Spacing="0">
                        <Label Text="Vĩnh Khánh Food" FontSize="18" FontAttributes="Bold" TextColor="#1A1A1A"/>
                        <Label Text="Khám phá thiên đường ẩm thực" FontSize="12" TextColor="#9E9E9E"/>
                    </VerticalStackLayout>

                    <!-- Language Button -->
                    <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="#F0F0F0"
                            HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLanguageButtonTapped"/>
                        </Border.GestureRecognizers>
                            <Label Text="&#xf57e;" FontFamily="FASolid" TextColor="#1A1A1A"
                               HorizontalOptions="Center" VerticalOptions="Center" FontSize="18"/>
                    </Border>
                </Grid>

                <!-- 2. Search Bar -->
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <Border StrokeThickness="0" BackgroundColor="#F5F1EE" StrokeShape="RoundRectangle 25" HeightRequest="50" Padding="15,0">
                        <Grid ColumnDefinitions="Auto, *">
                            <Label Text="&#xf002;" FontFamily="FASolid" TextColor="#8D6E63" 
                                   VerticalOptions="Center" FontSize="16" Margin="0,0,10,0"/>
                            <Entry Grid.Column="1" Placeholder="Tìm ốc, phá lấu, đồ nướng..." 
                                   FontSize="14" VerticalOptions="Center" BackgroundColor="Transparent" TextColor="#3E2723" PlaceholderColor="#8D6E63"/>
                        </Grid>
                    </Border>

                    <!-- Filter Button -->
                    <Button Grid.Column="1" Text="" BackgroundColor="#F48C06" HeightRequest="50" WidthRequest="50" CornerRadius="25">
                         <Button.ImageSource>
                            <FontImageSource Glyph="&#xf1de;" FontFamily="FASolid" Color="White" Size="20"/>
                        </Button.ImageSource>
                    </Button>
                </Grid>

                <!-- 3. Map Section -->
                <Border HeightRequest="220" StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="White">
                    <Grid>
                        <!-- Map Control -->
                        <mapsui:MapView x:Name="map" MyLocationEnabled="True"/>

                        <!-- Map Overlays -->
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="End" Margin="10" Spacing="10">
                             <Border BackgroundColor="White" HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                                <Label Text="&#xf124;" FontFamily="FASolid" TextColor="#333" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                             <Border BackgroundColor="White" HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                                <Label Text="&#xf5a0;" FontFamily="FASolid" TextColor="#333" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- 4. Categories -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="10" HeightRequest="40">
                        <!-- 'All' Button -->
                        <Border BackgroundColor="#F48C06" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="15,8">
                            <Label Text="Tất cả" TextColor="White" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                        </Border>

                        <!-- Other Categories -->
                        <Border BackgroundColor="#F5F1EE" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="15,8">
                             <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                 <Label Text="&#xf6d7;" FontFamily="FASolid" TextColor="#3E2723" FontSize="12"/> <!-- 'Oc' icon? Using generic food -->
                                 <Label Text="Ốc" TextColor="#3E2723" FontSize="13" FontAttributes="Bold"/>
                             </HorizontalStackLayout>
                        </Border>

                         <Border BackgroundColor="#F5F1EE" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="15,8">
                             <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                 <Label Text="&#xf818;" FontFamily="FASolid" TextColor="#3E2723" FontSize="12"/> <!-- Bowl appx -->
                                 <Label Text="Phá lấu" TextColor="#3E2723" FontSize="13" FontAttributes="Bold"/>
                             </HorizontalStackLayout>
                        </Border>

                         <Border BackgroundColor="#F5F1EE" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="15,8">
                             <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                 <Label Text="&#xf805;" FontFamily="FASolid" TextColor="#3E2723" FontSize="12"/> <!-- Fire/Grill appx -->
                                 <Label Text="Đồ nướng" TextColor="#3E2723" FontSize="13" FontAttributes="Bold"/>
                             </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- 5. Featured Section Header -->
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Quán ngon nổi bật" FontSize="16" FontAttributes="Bold" TextColor="#1A1A1A"/>
                    <Label Grid.Column="1" Text="Xem tất cả" FontSize="13" TextColor="#F48C06"/>
                </Grid>

                <!-- 6. List Items -->
                <CollectionView x:Name="PoiList" 
                    SelectionMode="Single"
                    SelectionChanged="OnPoiDetailTapped"
                    >
                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border BackgroundColor="White"
                                    StrokeShape="RoundRectangle 20"
                                    StrokeThickness="0"
                                    Padding="10"
                                    Margin="0,5">

                            <!-- khi nhấm vào POI -->
                            <!-- <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPoiDetailTapped"/>
                            </Border.GestureRecognizers> -->
                            

                                <Border.Shadow>
                                    <Shadow Brush="#E0E0E0"
                                            Offset="0,4"
                                            Radius="10"
                                            Opacity="0.3"/>
                                </Border.Shadow>

                                <Grid ColumnDefinitions="100,*"
                                    ColumnSpacing="15">

                                    <!-- Ảnh tạm -->
                                    <Image Source="{Binding PrimaryImage}"
                                        Aspect="AspectFill"
                                        HeightRequest="100"
                                        WidthRequest="100">
                                        <Image.Clip>
                                            <EllipseGeometry RadiusX="50"
                                                            RadiusY="50"
                                                            Center="50,50"/>
                                        </Image.Clip>
                                    </Image>

                                    <VerticalStackLayout Grid.Column="1"
                                                        Spacing="4">

                                        <!-- Tên -->
                                        <Label Text="{Binding Name}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="#1A1A1A"/>

                                        <!-- ID -->
                                        <!-- <Label Text="{Binding restaurantId,
                                                    StringFormat='ID: {0}'}"
                                            FontSize="11"
                                            TextColor="#9E9E9E"/> -->

                                        <!-- Địa chỉ -->
                                        <Label Text="{Binding Address}"
                                            FontSize="12"
                                            TextColor="#757575"/>

                                        <!-- Mô tả -->
                                        <Label Text="{Binding Description}"
                                            FontSize="12"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation"/>

                                        <!-- Toạ độ -->
                                        <!-- <Label FontSize="11"
                                            TextColor="#9E9E9E">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Lat: " />
                                                    <Span Text="{Binding Latitude}" />
                                                    <Span Text=" | Lng: " />
                                                    <Span Text="{Binding Longitude}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label> -->

                                        <!-- Trạng thái -->
                                        <Label FontSize="12">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Trạng thái: "
                                                        TextColor="#757575"/>
                                                    <Span Text="{Binding StatusText}"
                                                        TextColor="#4CAF50"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <!-- CreatedAt -->
                                        <!-- <Label Text="{Binding CreatedAt,
                                                    StringFormat='Tạo lúc: {0:dd/MM/yyyy HH:mm}'}"
                                            FontSize="11"
                                            TextColor="#9E9E9E"/> -->

                                        <!-- Audio file -->
                                        <!-- <Label Text="{Binding AudioFile,
                                                    StringFormat='Audio: {0}'}"
                                            FontSize="11"
                                            TextColor="#9E9E9E"/> -->

                                    </VerticalStackLayout>

                                </Grid>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>




            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Floating Button -->
            <Border x:Name="FloatingButton" IsVisible="False" StrokeThickness="0" BackgroundColor="#F48C06" StrokeShape="RoundRectangle 25" 
                HeightRequest="50" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,20" Padding="20,0">
                <Border.Shadow>
                 <Shadow Brush="#E65100" Offset="0,5" Radius="10" Opacity="0.4"/>
                </Border.Shadow>
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center" x:Name="NarratorButton">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNarratorTapped"/>
                        </HorizontalStackLayout.GestureRecognizers>
                        <Label Text="&#xf590;" FontFamily="FASolid" TextColor="White" FontSize="20" VerticalOptions="Center" />
                    <Label x:Name="NarratorText" Text="Bắt đầu thuyết minh" TextColor="White" FontAttributes="Bold" FontSize="15" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>

            <Grid x:Name="LanguagePopupOverlay"
                  IsVisible="False"
                  Opacity="0"
                  BackgroundColor="#80000000"
                  InputTransparent="False"
                  RowDefinitions="*,Auto">
                <BoxView Grid.Row="0" Color="Transparent">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLanguageOverlayTapped"/>
                    </BoxView.GestureRecognizers>
                </BoxView>

                <Grid Grid.Row="1" VerticalOptions="End">
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 28,28,0,0"
                            Padding="20,12,20,24">
                        <VerticalStackLayout Spacing="16">
                            <BoxView HeightRequest="4"
                                     WidthRequest="52"
                                     HorizontalOptions="Center"
                                     CornerRadius="2"
                                     Color="#E7E2DD"/>

                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Label Text="Chọn ngôn ngữ"
                                       FontSize="30"
                                       FontAttributes="Bold"
                                       TextColor="#1A1A1A"
                                       VerticalOptions="Center"/>
                                <Border Grid.Column="1"
                                        BackgroundColor="#F1EDE9"
                                        HeightRequest="32"
                                        WidthRequest="32"
                                        StrokeShape="RoundRectangle 16"
                                        StrokeThickness="0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnLanguageCloseTapped"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="&#xf00d;" FontFamily="FASolid"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           FontSize="14"
                                           TextColor="#7D746D"/>
                                </Border>
                            </Grid>
                            <!-- Ngôn ngữ  -->
                            <VerticalStackLayout Spacing="12">
                                <!-- Tiếng Việt  -->
                                <Border x:Name="VietnameseOption"
                                        BackgroundColor="#F7F3EF"
                                        Stroke="#F48C06"
                                        StrokeThickness="1.5"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="14,12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnLanguageOptionTapped" CommandParameter="vi-VN"/>
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <Label Text="🇻🇳" FontSize="20" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="Tiếng Việt" FontSize="20" FontAttributes="Bold" TextColor="#1A1A1A" VerticalOptions="Center"/>
                                        <Label x:Name="VietnameseCheck" Grid.Column="2" Text="✓" FontSize="16" TextColor="#F48C06" FontAttributes="Bold" VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                                <!-- Tiếng Anh  -->
                                <Border x:Name="EnglishOption"
                                        BackgroundColor="#F1EDE9"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="14,12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnLanguageOptionTapped" CommandParameter="en-US"/>
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <Label Text="🇺🇸" FontSize="20" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="English" FontSize="20" FontAttributes="Bold" TextColor="#1A1A1A" VerticalOptions="Center"/>
                                        <Label x:Name="EnglishCheck" Grid.Column="2" Text="✓" FontSize="16" TextColor="#F48C06" FontAttributes="Bold" VerticalOptions="Center" IsVisible="False"/>
                                    </Grid>
                                </Border> 
                                
                                <!-- Tiếng Trung  -->
                                <Border x:Name="ChineseOption"
                                        BackgroundColor="#F1EDE9"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="14,12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnLanguageOptionTapped" CommandParameter="zh-CN"/>
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <Label Text="🇨🇳" FontSize="20" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="中文" FontSize="20" FontAttributes="Bold" TextColor="#1A1A1A" VerticalOptions="Center"/>
                                        <Label x:Name="ChineseCheck" Grid.Column="2" Text="✓" FontSize="16" TextColor="#F48C06" FontAttributes="Bold" VerticalOptions="Center" IsVisible="False"/>
                                    </Grid>
                                </Border>
                                
                                <!-- Tiếng Hàn  -->
                                <Border x:Name="KoreanOption"
                                        BackgroundColor="#F1EDE9"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="14,12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnLanguageOptionTapped" CommandParameter="ko-KR"/>
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <Label Text="🇰🇷" FontSize="20" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="한국어" FontSize="20" FontAttributes="Bold" TextColor="#1A1A1A" VerticalOptions="Center"/>
                                        <Label x:Name="KoreanCheck" Grid.Column="2" Text="✓" FontSize="16" TextColor="#F48C06" FontAttributes="Bold" VerticalOptions="Center" IsVisible="False"/>
                                    </Grid>
                                </Border>

                                <!-- Tiếng Nhật  -->
                                <Border x:Name="JapaneseOption"
                                        BackgroundColor="#F1EDE9"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="14,12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnLanguageOptionTapped" CommandParameter="ja-JP"/>
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <Label Text="🇯🇵" FontSize="20" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="日本語" FontSize="20" FontAttributes="Bold" TextColor="#1A1A1A" VerticalOptions="Center"/>
                                        <Label x:Name="JapaneseCheck" Grid.Column="2" Text="✓" FontSize="16" TextColor="#F48C06" FontAttributes="Bold" VerticalOptions="Center" IsVisible="False"/>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Bottom Navigation Bar -->

        <shared:BottomNavigationView 
            ActiveTab="Home"
            Grid.Row="1"/>


    </Grid>
</ContentPage>